generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  CONFIRMED
  PROCESSING
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PaymentMethod {
  MPESA_STK
  MPESA_MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// User 

model User {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String   @unique
  phone         String?
  password      String? // null for Google OAuth users
  googleId      String?  @unique
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)

  // Password reset
  resetPasswordToken  String?   @unique
  resetPasswordExpiry DateTime?

  // Email verification
  verifyEmailToken  String?   @unique
  verifyEmailExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  cart      Cart?
  wishlist  Wishlist?
  orders    Order[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// Address 

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String // e.g. "Home", "Office"
  street    String
  city      String
  county    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// Product 

model Product {
  id            String   @id @default(cuid())
  name          String
  category      String
  slug          String
  price         Int // stored in KES (smallest unit — whole shillings)
  deliveryFee   Int      @default(0) // delivery fee charged per product in KES
  originalPrice Int? // for showing crossed-out prices
  stock         Int      @default(0)
  inStock       Boolean  @default(true)
  active        Boolean  @default(true)
  images        String[] // array of image URLs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@map("products")
}

// Cart 

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique   // null for guest carts
  sessionId  String?  @unique   // set for guests, null for authenticated users
  couponCode String?
  discount   Int?               // discount amount in KES
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  qty       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// Wishlist 

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// Order 

model Order {
  id        String  @id @default(cuid())
  ref       String  @unique // e.g. CST-20250727-0041
  userId    String? // null for guest orders
  sessionId String? // set for guest orders so they can be looked up by session
  addressId String? // null if address was entered manually (not saved)

  // Contact snapshot (captured at checkout, survives address edits)
  firstName String
  lastName  String
  email     String?
  phone     String

  // Delivery snapshot
  street String
  city   String
  county String
  notes  String?

  // Totals
  subtotal    Int // in KES
  deliveryFee Int // in KES
  discount    Int @default(0)
  total       Int // in KES

  status    OrderStatus @default(CONFIRMED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  payment Payment?

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String? // nullable — product may be deleted later
  name      String // snapshot of product name at time of order
  price     Int // snapshot of price at time of order
  qty       Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// Refresh Tokens

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique  // hashed token stored, raw token sent to client
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Payment 

model Payment {
  id      String        @id @default(cuid())
  orderId String        @unique
  method  PaymentMethod
  status  PaymentStatus @default(PENDING)
  amount  Int // in KES

  // M-Pesa STK Push
  stkPhone           String? // phone number the prompt was sent to
  checkoutRequestId  String? // Daraja CheckoutRequestID for polling
  mpesaReceiptNumber String? // receipt from Daraja callback

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}
